# (Required) The IP address of Docker host machine which can be found by running "ifconfig"
# Hint: look for "inet addr:" within "eth0" or "en0" for OSX
DOCKER_HOST_IP=192.168.170.53
KAFKA_BOOTSTRAP_SERVERS={KAFKA_BOOTSTRAP_SERVERS}:9092
LOGGING_LEVEL=DEBUG

# (Required) The full path of a directory on the host machine to be shared with docker containers.
# Hint: usually the path to the `jpo-ode` directory.
DOCKER_SHARED_VOLUME=""

# GitHub properties for pulling the latest version of the JPO-ODE
MAVEN_GITHUB_TOKEN=
MAVEN_GITHUB_ORG=usdot-jpo-ode

# Docker compose restart policy: https://docs.docker.com/engine/containers/start-containers-automatically/
RESTART_POLICY="on-failure:3"

# Available profiles:
# - all
#   - cm_full
#       - conflictmonitor-build
#       - deduplicator
#       - geojsonconverter
#       - ode
#       - adm
#   - cm_base
#       - conflictmonitor-build
#       - deduplicator
#   - deduplicator
#       - deduplicator
#   - ode_geojsonconverter
#       - geojsonconverter
#       - ode
#       - adm
# EXAMPLE: COMPOSE_PROFILES=kafka_connect_standalone,kafka_ui,mongo_express
# Refer to jpo-utils/.env for more profiles
COMPOSE_PROFILES=mec_deposit_base

# Set to "CONFLUENT" if broker is a Confluent Cloud broker
# Leave blank if broker is a local broker (e.g. Docker Compose)
KAFKA_TYPE=

# Set to actual Confluent Cloud access key and secret values for SASL authentication
CONFLUENT_KEY=""
CONFLUENT_SECRET=""

# IMP Variables
IMP_ENABLED="True"
IMP_CERT_PATH="resources/IMP"
IMP_VENDOR=""
IMP_MQTT_VENDOR="Public"
IMP_NETWORK_TYPE="non-VZ"
IMP_PARTNER_API_BASE_URI=""
IMP_PARTNER_API_USERNAME=""
IMP_PARTNER_API_PASSWORD=""
IMP_CLIENT_TYPE="Software"
IMP_CLIENT_SUB_TYPE="Application"
IMP_CACHE_REGISTRATION="true"
IMP_MEC_LATITUDE=""
IMP_MEC_LONGITUDE=""
IMP_PUBLISH_RATE="50"
IMP_PARTNER_API_CLEAR_TIM_ENABLED="True"
IMP_PARTNER_API_CLEAR_TIM_INTERVAL="10"

# The following variables are defaulted to the following sample values if no environment variables are provided
IMP_DEPOSITORS_BSM_MQTT_ENABLED="True"
IMP_DEPOSITORS_BSM_MQTT_KAFKA_TOPIC="topic.DeduplicatedOdeBsmJson"
IMP_DEPOSITORS_SPAT_MQTT_ENABLED="True"
IMP_DEPOSITORS_SPAT_MQTT_KAFKA_TOPIC="topic.OdeSpatJson"
IMP_DEPOSITORS_TIM_MQTT_ENABLED="True"
IMP_DEPOSITORS_TIM_MQTT_KAFKA_TOPIC="topic.OdeTimJson"
IMP_DEPOSITORS_TIM_API_ENABLED="True"
IMP_DEPOSITORS_TIM_API_KAFKA_TOPIC="topic.OdeTimJsonTMCFiltered"
IMP_DEPOSITORS_MAP_MQTT_ENABLED="True"
IMP_DEPOSITORS_MAP_MQTT_KAFKA_TOPIC="topic.OdeMapJson"
IMP_DEPOSITORS_MAP_API_ENABLED="True"
IMP_DEPOSITORS_MAP_API_KAFKA_TOPIC="topic.DeduplicatedOdeMapJson"