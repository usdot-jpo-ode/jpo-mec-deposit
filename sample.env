# (Required) The IP address of Docker host machine which can be found by running "ifconfig"
# Hint: look for "inet addr:" within "eth0" or "en0" for OSX
DOCKER_HOST_IP=

# GitHub properties for pulling the latest version of the JPO-ODE at build time
# NOTE: These variables are only required for building the geojson-converter image, not for running the image
MAVEN_GITHUB_TOKEN=
MAVEN_GITHUB_ORG=usdot-jpo-ode

# MEC deposit logging level: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL=INFO

# Docker compose restart policy: https://docs.docker.com/engine/containers/start-containers-automatically/
RESTART_POLICY="on-failure:3"

# Available profiles:
# - all
#   - mec_deposit_full
#       - mec_deposit
#       - ode
#       - adm
#   - mec_deposit_base
#       - mec_deposit
# EXAMPLE: COMPOSE_PROFILES=mec_deposit_full,kafka_full
# Refer to jpo-utils/.env for more profiles
COMPOSE_PROFILES=mec_deposit_full,kafka_full

# Set to "confluent" if broker is a Confluent Cloud broker
# Leave as "docker" if broker is a local broker
SPRING_PROFILES_ACTIVE=docker

# Set to actual Confluent Cloud access key and secret values for SASL authentication
CONFLUENT_KEY=""
CONFLUENT_SECRET=""

# Enable metrics collection and publishing to kafka and the actuator endpoint
METRICS_ENABLED="True"
METRICS_KAFKA_TOPIC="topic.MecDepositMetrics"

# ETX Variables
ETX_ENABLED="True"
ETX_CERT_PATH="resources/etx"

# ETX_REGISTRATION_VENDOR is the vendor name used to register the ETX client with the ETX Partner API
ETX_REGISTRATION_VENDOR=""

# ETX_MQTT_VENDOR is the vendor name used to connect to the ETX MQTT broker and publish messages
ETX_MQTT_VENDOR="Public"

# ETX_MQTT_MESSAGE_FORMAT is the message format used to publish messages to the ETX MQTT broker
# j2735_gr allows for adding timestamps to the ASN.1 message
# j2735 just sends the ASN.1 message
ETX_MQTT_MESSAGE_FORMAT="j2735_gr"

# --- mqtt-brokers.etx.mqtt (ETX Traffic Exchange connection + dual-publish routing) ---
# MQTT connection behavior
# Set ETX_MQTT_USE_TLS="False" and ETX_MQTT_USE_REGISTRATION="False" for TrafficAuth/NMI broker usage
ETX_MQTT_USE_TLS="True"
ETX_MQTT_USE_REGISTRATION="True"
ETX_MQTT_REQUIRE_SESSION_ID="True"
ETX_MQTT_BROKER_URI=""
ETX_MQTT_CLIENT_ID=""
ETX_MQTT_BROKER_TYPE="ETX"
ETX_MQTT_DUAL_PUBLISH_ENABLED="False"
ETX_MQTT_DUAL_PUBLISH_TARGETS="ETX,NMI,AV"
# Failures before ETX registration refresh is triggered (Spring: mqtt-brokers.etx.mqtt.registration-refresh-failure-threshold)
ETX_REGISTRATION_REFRESH_FAILURE_THRESHOLD="10"

# --- mqtt-brokers.nmi.mqtt (NMI / TrafficAuth publish client; separate from ETX Paho client) ---
NMI_MQTT_ENABLED="False"
NMI_MQTT_BROKER_URI="mqtt://mqtt.development.v2x.isscms.com:1883"
NMI_MQTT_CLIENT_ID="jpo-mec-deposit-nmi"
NMI_MQTT_QOS="0"
NMI_MQTT_PUBLISH_RATE="100"
NMI_MQTT_PRECISION="7"
NMI_MQTT_CIRCUIT_BREAKER_FAILURE_THRESHOLD="10"

# --- mqtt-brokers.av.mqtt (AV publish client; same topic style/signing path as NMI) ---
AV_MQTT_ENABLED="False"
AV_MQTT_BROKER_URI=""
AV_MQTT_CLIENT_ID="jpo-mec-deposit-av"
AV_MQTT_QOS="0"
AV_MQTT_PUBLISH_RATE="100"
AV_MQTT_PRECISION="7"
AV_MQTT_CIRCUIT_BREAKER_FAILURE_THRESHOLD="10"

# ETX Network Type - "VZ" or "non-VZ"
ETX_NETWORK_TYPE="non-VZ"

# ETX Partner API Base URI
ETX_PARTNER_API_BASE_URI=""
# ETX Partner API Username
ETX_PARTNER_API_USERNAME=""
# ETX Partner API Password
ETX_PARTNER_API_PASSWORD=""

# ETX Client Type and Subtype - must be one of the values in EtxClientType and EtxClientSubType
ETX_CLIENT_TYPE="Software"
ETX_CLIENT_SUB_TYPE="Application"

# Cache registration with ETX Partner API
ETX_CACHE_REGISTRATION="true"

# Location to use for ETX Partner API registration
ETX_MEC_LATITUDE="40"
ETX_MEC_LONGITUDE="-100"

# Publish rate for depositors (in messages per second) - generally limited by ETX ACL limits
ETX_PUBLISH_RATE="50"

# Clear old TIM messages from the ETX Partner API
ETX_PARTNER_API_CLEAR_TIM_ENABLED="False"
ETX_PARTNER_API_CLEAR_TIM_INTERVAL="60"

# --- mqtt-brokers.*.depositors (per-broker MQTT depositors; Kafka listener topics use ETX profile) ---
# Stale threshold (ms) per broker profile; NMI defaults to ETX value if unset (see application.yaml).
ETX_DEPOSITORS_STALE_MESSAGE_THRESHOLD="250"
# NMI_DEPOSITORS_STALE_MESSAGE_THRESHOLD="250"

# Shared defaults: bound to BOTH mqtt-brokers.etx.depositors and mqtt-brokers.nmi.depositors unless a
# per-broker override below is set (ETX_MQTT_BROKERS_ETX_* or NMI_MQTT_BROKERS_NMI_*).

# MQTT depositors (BSM, SPAT, TIM, MAP, SDSM, geohash)
ETX_DEPOSITORS_BSM_MQTT_ENABLED="True"
ETX_DEPOSITORS_BSM_MQTT_KAFKA_TOPIC="topic.OdeBsmJson"

ETX_DEPOSITORS_SPAT_MQTT_ENABLED="True"
ETX_DEPOSITORS_SPAT_MQTT_KAFKA_TOPIC="topic.OdeSpatJson"
ETX_DEPOSITORS_SPAT_INTERSECTION_FILTER_ENABLED="False"
ETX_DEPOSITORS_SPAT_ALLOWED_INTERSECTIONS=12111,12112,12113
ETX_DEPOSITORS_SPAT_BLOCKED_INTERSECTIONS=12114,12115,12116

ETX_DEPOSITORS_TIM_MQTT_ENABLED="True"
ETX_DEPOSITORS_TIM_MQTT_KAFKA_TOPIC="topic.OdeTimJson"

ETX_DEPOSITORS_MAP_MQTT_ENABLED="True"
ETX_DEPOSITORS_MAP_MQTT_KAFKA_TOPIC="topic.OdeMapJson"

ETX_DEPOSITORS_SDSM_MQTT_ENABLED="True"
ETX_DEPOSITORS_SDSM_MQTT_KAFKA_TOPIC="topic.OdeSdsmJson"

ETX_DEPOSITORS_GEOHASH_MQTT_ENABLED="False"
ETX_DEPOSITORS_GEOHASH_MQTT_KAFKA_TOPIC="topic.GeoHashRoutedMsg"

# Optional per-broker MQTT depositor toggles (Spring relaxed binding examples):
# ETX_MQTT_BROKERS_ETX_DEPOSITORS_BSM_MQTT_ENABLED="True"
# ETX_MQTT_BROKERS_ETX_DEPOSITORS_SPAT_MQTT_ENABLED="True"
# NMI_MQTT_BROKERS_NMI_DEPOSITORS_BSM_MQTT_ENABLED="False"
# NMI_MQTT_BROKERS_NMI_DEPOSITORS_SPAT_MQTT_ENABLED="False"
# NMI_MQTT_BROKERS_NMI_DEPOSITORS_MAP_MQTT_ENABLED="False"
# AV_MQTT_BROKERS_AV_DEPOSITORS_BSM_MQTT_ENABLED="False"
# AV_MQTT_BROKERS_AV_DEPOSITORS_SPAT_MQTT_ENABLED="False"
# AV_MQTT_BROKERS_AV_DEPOSITORS_MAP_MQTT_ENABLED="False"
# Optional NMI-only SPAT filter (falls back to ETX_* if unset):
# NMI_DEPOSITORS_SPAT_INTERSECTION_FILTER_ENABLED="False"
# NMI_DEPOSITORS_SPAT_ALLOWED_INTERSECTIONS=
# NMI_DEPOSITORS_SPAT_BLOCKED_INTERSECTIONS=
# Optional AV-only SPAT filter (falls back to ETX_* if unset):
# AV_DEPOSITORS_SPAT_INTERSECTION_FILTER_ENABLED="False"
# AV_DEPOSITORS_SPAT_ALLOWED_INTERSECTIONS=
# AV_DEPOSITORS_SPAT_BLOCKED_INTERSECTIONS=

# --- mqtt-brokers.etx.depositors.tim|map.api (TIM/MAP Partner API depositors) ---
ETX_DEPOSITORS_TIM_API_ENABLED="True"
ETX_DEPOSITORS_TIM_API_KAFKA_TOPIC="topic.OdeTimJsonTMCFiltered"

# NOTE: The MAP API depositor requires the jpo-deduplicator service to be running
ETX_DEPOSITORS_MAP_API_ENABLED="False"
ETX_DEPOSITORS_MAP_API_KAFKA_TOPIC="topic.DeduplicatedOdeMapJson"

#########################
# Kafka Properties - START

KAFKA_TOPIC_CREATE_MECDEPOSIT=true  
KAFKA_TOPIC_CREATE_DEDUPLICATOR=true

# Kafka topic auto-creation settings
KAFKA_TOPIC_AUTO_CREATE=true
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1
KAFKA_TOPIC_RETENTION_MS=300000

KAFKA_LINGER_MS=1
KAFKA_CONCURRENCY=1
KAFKA_CONSUMER_GROUP_ID=jpo-mec-deposit
KAFKA_BOOTSTRAP_SERVERS=${DOCKER_HOST_IP}:9092
KAFKA_LOG_RETENTION_HOURS=3
KAFKA_LOG_RETENTION_BYTES=10737418240 # 10GB

# Local Kafka broker properties - you can override these if you want, but the defaults should be fine for normal use
# The application will not boot if these environment variables are set to empty strings (e.g. KAFKA_BATCH_SIZE=)
KAFKA_COMPRESSION_TYPE="zstd"
KAFKA_BATCH_SIZE=16384
KAFKA_ACKS="all"
KAFKA_RETRIES=0
KAFKA_KEY_SERIALIZER="org.apache.kafka.common.serialization.StringSerializer"
KAFKA_VALUE_SERIALIZER="org.apache.kafka.common.serialization.StringSerializer"
KAFKA_PARTITIONER_CLASS="org.apache.kafka.clients.producer.internals.DefaultPartitioner"


#########################
# JPO-ODE Specific Properties - START

ODE_VERSION=2025-q3

# The type of Kafka broker for the ODE to connect to. If set to "CONFLUENT", the broker will be Confluent Cloud. Otherwise, it will be a local Kafka broker.
KAFKA_TYPE=

# These are optional
DATA_SIGNING_ENABLED_RSU=false
DATA_SIGNING_ENABLED_SDW=false
DEFAULT_SNMP_PROTOCOL=
ODE_SECURITY_SVCS_SIGNATURE_URI=

# ODE Monitoring
ODE_TIM_INGEST_MONITORING_ENABLED=false
# The interval is measured in seconds. 60 seconds is a sane default for local monitoring, but you may want to increase
# the interval to 3600 (1 hour) or more for production monitoring to reduce the noise in logs for healthy systems
ODE_TIM_INGEST_MONITORING_INTERVAL=60

# Enable the STOMP Exporter
ODE_STOMP_EXPORTER_ENABLED=false

# JPO-ODE Specific Properties - END
#########################